# Azure OpenAI (required for natural-language querying)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# PostgreSQL used by the Streamlit/PandasAI application
DBEAVER_URL=postgresql://localhost:5432
DBEAVER_DATABASE=cellminerdb_new
DBEAVER_USERNAME=cellminer
DBEAVER_PASSWORD=replace_me

# Local CellMinerCDB extraction (R)
CELLMINER_DATA_DIR=/absolute/path/to/this/repository
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=cellminerdb_new
LOCAL_DB_USER=cellminer
LOCAL_DB_PASSWORD=replace_me

# Optional local -> remote PostgreSQL transfer (uploader_optimized.r)
REMOTE_DB_URL=postgresql://YOUR-HOST:5432
REMOTE_DB_NAME=postgres
REMOTE_DB_USER=replace_me
REMOTE_DB_PASSWORD=replace_me

# PandasAI runtime configuration
PANDASAI_BYPASS_SECURITY=true
PANDASAI_MAX_RETRIES=1
CLEAR_EXISTING_DATASET=false
